#
# Copy an ftbfs VM's backups (ftbfs-backup's DEST) to this machine,
# incrementally: rsync over `lxc exec`, so the VM needs no ssh. Run it
# where the backups should live, from a machine trusted by the VM's LXD
# host (docs/DEPLOYMENT.md, "Backups").
#
#   ftbfs-backup-pull REMOTE:INSTANCE DEST [SRC]
set -eu
if [ "${1:-}" = --rsh ]; then
    # rsync's remote shell: `--rsh HOST COMMAND...`, HOST unused.
    shift 2
    exec lxc exec "$FTBFS_VM" -- "$@"
fi
vm=${1:?usage: ftbfs-backup-pull REMOTE:INSTANCE DEST [SRC]}
dest=${2:?usage: ftbfs-backup-pull REMOTE:INSTANCE DEST [SRC]}
src=${3:-/var/backups/ftbfs}

mkdir -p "$dest"
FTBFS_VM=$vm rsync -a --delete -e "$(realpath "$0") --rsh" \
    "vm:$src/" "$dest/"
echo "pulled $vm:$src to $dest ($(ls -1 "$dest/db" | tail -n 1))"
