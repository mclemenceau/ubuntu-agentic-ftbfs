# One pass of the pipeline over a fresh FTBFS list. Started by
# ftbfs-daily.timer; systemd never starts it twice at once.
[Unit]
Description=ftbfs daily run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ftbfs
Group=ftbfs
WorkingDirectory=/srv/ftbfs
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/ftbfs/.venv/bin/ftbfs run --ingest
