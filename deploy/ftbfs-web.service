# The web UI on loopback; a proxy or tunnel brings it to the network
# (docs/DEPLOYMENT.md).
[Unit]
Description=ftbfs web UI
After=network-online.target
Wants=network-online.target

[Service]
User=ftbfs
Group=ftbfs
WorkingDirectory=/srv/ftbfs
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/ftbfs/.venv/bin/ftbfs serve --port 8047
# Runs started from the UI are detached children in this service's
# cgroup: a restart of the UI must stop the server only, not them.
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
